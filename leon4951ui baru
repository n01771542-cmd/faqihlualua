local function CreateTab(text, icon, pageName, order)
    local Button = Instance.new("TextButton")
    Button.Name = pageName .. "Tab"
    Button.Size = UDim2.new(1, 0, 0, 48)
    Button.BackgroundColor3 = Theme.Card
    Button.BorderSizePixel = 0
    Button.Text = ""
    Button.AutoButtonColor = false
    Button.LayoutOrder = order
    Button.Parent = TabContainer

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 13)
    corner.Parent = Button

    local iconLabel = Instance.new("TextLabel")
    iconLabel.Size = UDim2.fromOffset(32, 32)
    iconLabel.Position = UDim2.fromOffset(8, 8)
    iconLabel.BackgroundTransparency = 1
    iconLabel.Text = icon
    iconLabel.TextColor3 = Theme.TextSecondary
    iconLabel.Font = Enum.Font.GothamBold
    iconLabel.TextSize = 16
    iconLabel.Parent = Button

    local textLabel = Instance.new("TextLabel")
    textLabel.Size = UDim2.new(1, -48, 1, 0)
    textLabel.Position = UDim2.fromOffset(44, 0)
    textLabel.BackgroundTransparency = 1
    textLabel.Text = text
    textLabel.TextColor3 = Theme.TextSecondary
    textLabel.Font = Enum.Font.GothamBold
    textLabel.TextSize = 9
    textLabel.TextXAlignment = Enum.TextXAlignment.Left
    textLabel.Parent = Button

    TabButtons[pageName] = {
        Button = Button,
        Icon = iconLabel,
        Text = textLabel
    }

    Button.MouseEnter:Connect(function()
        if CurrentPage ~= pageName then
            Tween(Button, 0.15, {
                BackgroundColor3 = Theme.CardHover
            })
        end
    end)

    Button.MouseLeave:Connect(function()
        if CurrentPage ~= pageName then
            Tween(Button, 0.15, {
                BackgroundColor3 = Theme.Card
            })
        end
    end)

    Button.MouseButton1Click:Connect(function()
        if CurrentPage == pageName then
            return
        end

        for _, data in pairs(PageObjects) do
            data.Visible = false
        end

        for _, data in pairs(TabButtons) do
            Tween(data.Button, 0.18, {
                BackgroundColor3 = Theme.Card
            })

            Tween(data.Text, 0.18, {
                TextColor3 = Theme.TextSecondary
            })

            Tween(data.Icon, 0.18, {
                TextColor3 = Theme.TextSecondary
            })
        end

        local targetPage = PageObjects[pageName]

        if targetPage then
            targetPage.Visible = true
            targetPage.Position = UDim2.new(0, 12, 0, 0)

            Tween(targetPage, 0.22, {
                Position = UDim2.new(0, 0, 0, 0)
            }, Enum.EasingStyle.Quart)
        end

        Tween(Button, 0.18, {
            BackgroundColor3 = Theme.Accent
        })

        Tween(textLabel, 0.18, {
            TextColor3 = Color3.fromRGB(255, 255, 255)
        })

        Tween(iconLabel, 0.18, {
            TextColor3 = Color3.fromRGB(255, 255, 255)
        })

        CurrentPage = pageName
    end)

    return Button
end

