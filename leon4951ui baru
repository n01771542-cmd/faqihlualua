    Tween(Toast, 0.28, {
        Position = UDim2.new(0, 0, 0, 0)
    }, Enum.EasingStyle.Quart)

    task.delay(2.2, function()
        if Toast and Toast.Parent then
            local tween = Tween(
                Toast,
                0.25,
                {
                    Position = UDim2.new(0, 0, 1, 10)
                },
                Enum.EasingStyle.Quart
            )

            if tween then
                tween.Completed:Wait()
            end

            if Toast then
                Toast:Destroy()
            end
        end
    end)
end

