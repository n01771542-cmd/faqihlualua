        Enum.EasingStyle.Quart,
        Enum.EasingDirection.Out
    )

    Tween(
        MainFrame,
        0.28,
        {
            BackgroundTransparency = 0
        },
        Enum.EasingStyle.Quart
    )

    task.delay(0.05, function()
        Tween(
            Content,
            0.32,
            {
                Position = UDim2.fromOffset(14, 72)
            },
            Enum.EasingStyle.Quart
        )
    end)

    SetButtonsForNormal()

    task.delay(0.5, function()
        if MainFrame.Parent then
            MainFrame.Position = normalPosition
            MainFrame.Size = NORMAL_SIZE
        end

        IsTransitioning = false
    end)
end

local function MoveToMini()
    if IsTransitioning or IsMinimized then
        return
    end

    IsTransitioning = true
    IsMinimized = true

    local miniPosition = GetMiniPosition()

    Tween(
        Content,
        0.18,
        {
            Position = UDim2.new(0, 14, 1, 20)
        },
        Enum.EasingStyle.Quart
    )

    local mainTween = Tween(
        MainFrame,
        0.5,
        {
            Position = miniPosition,
            Size = MINI_SIZE
        },
        Enum.EasingStyle.Quart,
        Enum.EasingDirection.Out
    )

    SetButtonsForMini()

    task.delay(0.18, function()
        if TabPanel.Parent then
            TabPanel.Visible = false
        end
    end)

    if mainTween then
        mainTween.Completed:Wait()
    end

    if MainFrame.Parent then
        MainFrame.Position = miniPosition
        MainFrame.Size = MINI_SIZE
    end

    IsTransitioning = false
end

