local function Tween(object, duration, properties, style, direction)
    if not object or not object.Parent then
        return
    end

    local tweenInfo = TweenInfo.new(
        duration or 0.2,
        style or Enum.EasingStyle.Quart,
        direction or Enum.EasingDirection.Out
    )

    local tween = TweenService:Create(object, tweenInfo, properties)
    tween:Play()

    return tween
end

local function IsFavorite(scriptData)
    if not scriptData then
        return false
    end

    local source = scriptData.source

    for _, item in ipairs(FavoriteScripts) do
        if type(item) == "table" then
            if item.source == source then
                return true
            end
        elseif item == source then
            return true
        end
    end

    return false
end

local function AddFavorite(scriptData)
    if not scriptData then
        return
    end

    if IsFavorite(scriptData) then
        return
    end

    table.insert(FavoriteScripts, {
        name = scriptData.name,
        keyStatus = scriptData.keyStatus,
        source = scriptData.source
    })

    SaveJSON(FAVORITE_CONFIG, FavoriteScripts)
end

local function RemoveFavorite(scriptData)
    if not scriptData then
        return
    end

    for i = #FavoriteScripts, 1, -1 do
        local item = FavoriteScripts[i]

        if type(item) == "table" and item.source == scriptData.source then
            table.remove(FavoriteScripts, i)
        elseif item == scriptData.source then
            table.remove(FavoriteScripts, i)
        end
    end

    SaveJSON(FAVORITE_CONFIG, FavoriteScripts)
end

