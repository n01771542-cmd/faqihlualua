    IsTransitioning = true
    IsMinimized = false

    TabPanel.Visible = true

    local miniPosition = MainFrame.Position
    local normalPosition = GetNormalCenterPosition()

    MainFrame.AnchorPoint = Vector2.new(0.5, 0.5)

    Tween(
