local targetTabPosition = TabPanel.Position
local FOLLOW_SPEED = 11

local function GetTabTargetPosition()
    local mainPos = MainFrame.AbsolutePosition
    local mainSize = MainFrame.AbsoluteSize

    local targetX = mainPos.X - TabPanel.AbsoluteSize.X - 16
    local targetY = mainPos.Y + 70

    return Vector2.new(targetX, targetY)
end

RunService.RenderStepped:Connect(function(deltaTime)
    if not MainFrame.Parent or not TabPanel.Parent then
        return
    end

    local target = GetTabTargetPosition()

    local current = Vector2.new(
        TabPanel.AbsolutePosition.X,
        TabPanel.AbsolutePosition.Y
    )

    local alpha = 1 - math.exp(-FOLLOW_SPEED * deltaTime)

    local newPosition = current:Lerp(target, alpha)

    TabPanel.Position = UDim2.fromOffset(
        newPosition.X,
        newPosition.Y
    )
end)

