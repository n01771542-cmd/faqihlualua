        end

        ShowToast("Menjalankan: " .. tostring(item.name), false)

        task.spawn(function()
            local codeToRun = rawSource

            if rawSource:match("^https?://") then
                local successFetch, response = pcall(function()
                    if type(game.HttpGet) == "function" then
                        return game:HttpGet(rawSource)
                    end

                    if type(request) == "function" then
                        local result = request({
                            Url = rawSource,
                            Method = "GET"
                        })

                        if type(result) == "table" then
                            return result.Body
                        end
                    end

                    error("HTTP tidak tersedia")
                end)

                if not successFetch or type(response) ~= "string" or response == "" then
                    ShowToast("Gagal mengambil source!", true)
                    return
                end

                codeToRun = response
            end

            if type(loadstring) ~= "function" then
                ShowToast("loadstring tidak tersedia!", true)
                return
            end

            local successCompile, compiled = pcall(function()
                return loadstring(codeToRun)
            end)

            if not successCompile or type(compiled) ~= "function" then
                ShowToast("Gagal compile script!", true)
                return
            end

            local successExecute = pcall(compiled)

