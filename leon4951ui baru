Header.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then

        if IsTransitioning then
            return
        end

        local startPosition = MainFrame.Position
        local dragStart = input.Position
        local dragging = true

        local connection
        connection = UserInputService.InputChanged:Connect(function(changedInput)
            if not dragging then
                return
            end

            if changedInput.UserInputType ~= Enum.UserInputType.MouseMovement
                and changedInput.UserInputType ~= Enum.UserInputType.Touch then
                return
            end

            local delta = changedInput.Position - dragStart

            MainFrame.Position = UDim2.new(
                startPosition.X.Scale,
                startPosition.X.Offset + delta.X,
                startPosition.Y.Scale,
                startPosition.Y.Offset + delta.Y
            )
        end)

        local endConnection
        endConnection = UserInputService.InputEnded:Connect(function(endInput)
            if endInput.UserInputType == Enum.UserInputType.MouseButton1
                or endInput.UserInputType == Enum.UserInputType.Touch then

                dragging = false

                if connection then
                    connection:Disconnect()
                end

                if endConnection then
                    endConnection:Disconnect()
                end
            end
        end)
    end
end)

