local CustomScriptConfigName = "leon4951hub_custom_scripts.json"

local CustomScriptsList = {}
local CustomScriptFavorites = {}

-- ============================================================================
-- [ LOAD / SAVE ]
-- ============================================================================

local function LoadCustomScriptData()
    CustomScriptsList = {}
    CustomScriptFavorites = {}

    if readfile then
        local success, content = pcall(function()
            if isfile and not isfile(CustomScriptConfigName) then
                return nil
            end

            return readfile(CustomScriptConfigName)
        end)

        if success and content and content ~= "" then
            local decodeSuccess, decoded = pcall(function()
                return HttpService:JSONDecode(content)
            end)

            if decodeSuccess and type(decoded) == "table" then
                if type(decoded.scripts) == "table" then
                    CustomScriptsList = decoded.scripts
                else
                    -- Compatibility dengan format lama
                    CustomScriptsList = decoded
                end

                if type(decoded.favorites) == "table" then
                    CustomScriptFavorites = decoded.favorites
                end
            end
        end
    end
end

local function SaveCustomScriptData()
    if not writefile then
        return false
    end

    local success = pcall(function()
        writefile(
            CustomScriptConfigName,
            HttpService:JSONEncode({
                scripts = CustomScriptsList,
                favorites = CustomScriptFavorites
            })
        )
    end)

    return success
end

LoadCustomScriptData()

-- ============================================================================
-- [ STATUS ]
-- ============================================================================

local function NormalizeCustomScriptStatus(status)
    if type(status) ~= "string" then
        return "No Key"
    end

    status = status:lower()
    status = status:gsub("^%s+", "")
    status = status:gsub("%s+$", "")

    if status == "key" then
        return "Key"
    end

    return "No Key"
end

-- ============================================================================
-- [ CREATE DATA ]
-- ============================================================================

local function CreateCustomScriptData(name, keyStatus, source)

    name = tostring(name or "")
    source = tostring(source or "")

    name = name:gsub("^%s+", "")
    name = name:gsub("%s+$", "")

    if name == "" then
        name = "Untitled"
    end

    keyStatus = NormalizeCustomScriptStatus(keyStatus)

    if source == "" then
        return nil, "URL / source kosong!"
    end

    return {
        name = name,
        keyStatus = keyStatus,
        source = source
    }
end

-- ============================================================================
-- [ ADD ]
-- ============================================================================

local function AddCustomScript(name, keyStatus, source)

    local scriptData, errorMessage = CreateCustomScriptData(
        name,
        keyStatus,
        source
    )

    if not scriptData then
        return false, errorMessage
    end

    table.insert(
        CustomScriptsList,
        scriptData
    )

    SaveCustomScriptData()

    return true, scriptData
end

-- ============================================================================
-- [ DELETE ]
-- ============================================================================

local function DeleteCustomScript(index)

    index = tonumber(index)

    if not index or not CustomScriptsList[index] then
        return false, "Script tidak ditemukan!"
    end

    local removed = table.remove(
        CustomScriptsList,
        index
    )

    if removed then
        for i = #CustomScriptFavorites, 1, -1 do

            local favorite = CustomScriptFavorites[i]

            if type(favorite) == "table" then
                if favorite.source == removed.source then
                    table.remove(
                        CustomScriptFavorites,
                        i
                    )
                end
            elseif type(favorite) == "string" then
                if favorite == removed.name then
                    table.remove(
                        CustomScriptFavorites,
                        i
                    )
                end
            end
        end
    end

    SaveCustomScriptData()

    return true, removed
end

-- ============================================================================
-- [ FAVORITE CHECK ]
-- ============================================================================

local function IsCustomScriptFavorite(script)

    if type(script) ~= "table" then
        return false
    end

    for _, favorite in ipairs(CustomScriptFavorites) do

        if type(favorite) == "table" then
            if favorite.source == script.source then
                return true
            end

        elseif type(favorite) == "string" then
            if favorite == script.name then
                return true
            end
        end
    end

    return false
end

-- ============================================================================
-- [ TOGGLE FAVORITE ]
-- ============================================================================

local function ToggleCustomScriptFavorite(index)

    index = tonumber(index)

    local script = CustomScriptsList[index]

    if not script then
        return false, "Script tidak ditemukan!"
    end

    if IsCustomScriptFavorite(script) then

        for i = #CustomScriptFavorites, 1, -1 do

            local favorite = CustomScriptFavorites[i]

            if type(favorite) == "table"
                and favorite.source == script.source then

                table.remove(
                    CustomScriptFavorites,
                    i
                )
            elseif type(favorite) == "string"
                and favorite == script.name then

                table.remove(
                    CustomScriptFavorites,
                    i
                )
            end
        end

    else

        table.insert(
            CustomScriptFavorites,
            {
                name = script.name,
                keyStatus = script.keyStatus,
                source = script.source
            }
        )
    end

    SaveCustomScriptData()

    return true
end

-- ============================================================================
-- [ EXECUTE ]
-- ============================================================================

local function ExecuteCustomScript(script)

    if type(script) ~= "table" then
        return false, "Data script tidak valid!"
    end

    local source = tostring(script.source or "")

    if source == "" then
        return false, "Source script kosong!"
    end

    local codeToRun = source

    if source:match("^https?://") then

        local fetchSuccess, response = pcall(function()

            if game.HttpGet then
                return game:HttpGet(source)

            elseif request then

                local responseData = request({
                    Url = source,
                    Method = "GET"
                })

                if responseData then
                    return responseData.Body
                end

                return nil

            else
                error("HTTP tidak didukung")
            end
        end)

        if not fetchSuccess or not response then
            return false, "Gagal mengambil URL script!"
        end

        codeToRun = response
    end

    local compileSuccess, compiled = pcall(function()
        return loadstring(codeToRun)
    end)

    if not compileSuccess or type(compiled) ~= "function" then
        return false, "Gagal kompilasi script!"
    end

    local executeSuccess, executeError = pcall(function()
        compiled()
    end)

    if not executeSuccess then
        return false, executeError or "Gagal menjalankan script!"
    end

    return true, "Berhasil dieksekusi!"
end

