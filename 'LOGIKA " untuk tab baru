-- ============================================================================
-- [ RENDER SCRIPT LIST ]
-- ============================================================================

local function RenderCustomScriptList()

    for _, child in ipairs(SavedList:GetChildren()) do

        if not child:IsA("UIListLayout") then
            child:Destroy()
        end
    end

    local query = SearchBox.Text or ""

    local results = {}

    query = query:lower()

    for index, script in ipairs(CustomScriptsList) do

        local name = tostring(script.name or ""):lower()
        local status = NormalizeCustomScriptStatus(
            script.keyStatus
        )

        local matchesFilter =
            Filter == "ALL"
            or status == Filter

        local matchesSearch =
            query == ""
            or name:find(query, 1, true)
            or status:lower():find(query, 1, true)

        if matchesFilter and matchesSearch then

            table.insert(results, {
                index = index,
                data = script
            })
        end
    end

    if #results == 0 then

        local message = "Belum ada script."

        if #CustomScriptsList > 0 then
            message = "Tidak ada script yang cocok."
        end

        CreateEmptyLabel(message)

        return
    end

    -- ========================================================================
    -- [ CREATE EACH SCRIPT CARD ]
    -- ========================================================================

    for order, result in ipairs(results) do

        local index = result.index
        local script = result.data

        local Card = Instance.new("Frame")
        Card.Name = "Script_" .. tostring(index)
        Card.Size = UDim2.new(1, -2, 0, 66)
        Card.BackgroundColor3 = CustomTabTheme.Card
        Card.BorderSizePixel = 0
        Card.LayoutOrder = order
        Card.Parent = SavedList

        Instance.new("UICorner", Card).CornerRadius = UDim.new(0, 10)

        local CardStroke = Instance.new("UIStroke")
        CardStroke.Color = CustomTabTheme.Border
        CardStroke.Thickness = 1
        CardStroke.Parent = Card

        -- ================================================================
        -- [ NAME ]
        -- ================================================================

        local NameLabel = Instance.new("TextLabel")
