local function MinimizeUI()
	if IsTransitioning or IsMinimized then return end
	IsTransitioning = true
	IsMinimized = true

	Tween(MainFrame, 0.3, { Position = UDim2.fromScale(0.5, 0.5) })
	task.wait(0.3)
	MainFrame.Visible = false
	ToggleButton.Visible = true
	Tween(ToggleButton, 0.4, { Position = UDim2.fromOffset(Workspace.CurrentCamera.ViewportSize.X * 0.5, -5) })
	task.wait(0.4)
	IsTransitioning = false
end

local function RestoreUI()
	if IsTransitioning or not IsMinimized then return end
	IsTransitioning = true

	Tween(ToggleButton, 0.3, { Position = UDim2.fromScale(0.5, 0.5) })
	task.wait(0.3)
	ToggleButton.Visible = false
	MainFrame.Visible = true
	Tween(MainFrame, 0.4, { Position = MAIN_HOME_POSITION })
	task.wait(0.4)
	IsMinimized = false
	IsTransitioning = false
end

