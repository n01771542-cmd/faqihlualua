-- Compact data format: {name, status, recommended, url}
local function NormalizeScriptData(raw)
    local result = {}
    for i, entry in ipairs(raw) do
        result[i] = {
            name = entry[1],
            status = entry[2],
            recommended = entry[3],
            url = entry[4],
        }
    end
    return result
end

