local function NeutralizeTraps()
	local debris = Workspace:FindFirstChild("__DEBRIS")
	if not debris then return end
	for _, d in ipairs(debris:GetChildren()) do
		if d.Name == "PlayerTrap" and d:GetAttribute("Owner") ~= LocalPlayer.Name then
			if d:IsA("BasePart") then d.CanTouch = false; d.CanQuery = false end
			for _, c in ipairs(d:GetChildren()) do
				if c:IsA("BasePart") then
					c.CanTouch = false; c.CanQuery = false
					if c.Name == "Hitbox" then c.CFrame = CFrame.new(0, -999, 0) end
				end
			end
			local tt = d:FindFirstChildWhichIsA("TouchTransmitter", true)
			if tt then pcall(function() tt:Destroy() end) end
		end
	end
end

local function EmergencyBrake()
	local hum, hrp = select(2, getCharacterAndRoot())
	if hrp then
		hrp.AssemblyLinearVelocity = Vector3.zero
		hrp.AssemblyAngularVelocity = Vector3.zero
		pcall(function()
			hrp.Velocity = Vector3.zero
			hrp.RotVelocity = Vector3.zero
		end)
	end
	if hum and hrp then
		hum:MoveTo(hrp.Position)
	end
end

local function isPlayerCarryingEgg()
	local pg = LocalPlayer:FindFirstChildOfClass("PlayerGui")
	local dropGui = pg and pg:FindFirstChild("DropHeldEgg")
	if dropGui and dropGui.Enabled == true then return true end
	
	local char = LocalPlayer.Character
	if char then
		for _, t in ipairs(char:GetChildren()) do
			if t:IsA("Model") or t:IsA("Tool") then
				local tName = t.Name:lower()
				if tName:find("egg") or tName:find("telur") or t:GetAttribute("Uid") or t:GetAttribute("AssetCategory") or t:GetAttribute("IsEgg") == true then
					return true
				end
			end
		end
	end
	
	return false
end

-- NAVIGASI PRESISI DENGAN PENGURANGAN 4 STUDS & FREEZE ANCHOR
local function PreciseWalkTo(targetPos, shouldJump, isFinalTarget, lockZ)
	local char, hum, hrp = getCharacterAndRoot()
	if not hum or not hrp or not targetPos then return false end
	
	local startTime = os.clock()
	local lastJumpTime = 0

	while isAutoStealActive do
		RunService.Heartbeat:Wait()
		
		local currentPos = hrp.Position
		local targetX = targetPos.X
		local targetZ = lockZ or targetPos.Z
		
		local flatTarget = Vector3.new(targetX, currentPos.Y, targetZ)
		local dist = (Vector3.new(targetX, currentPos.Y, targetZ) - currentPos).Magnitude
		
		-- Sistem Anti-Kelewatan (Mulai melambat saat berjarak 4 studs)
		local currentSpeed = tonumber(walkSpeed) or 16
		if dist <= 4.0 then
			currentSpeed = math.clamp(dist * 1.5, 1, 6)
		end
		
		hum.WalkSpeed = math.clamp(currentSpeed, 1, 300)
		
		-- Kunci sumbu Z jika diperlukan agar lurus di jalur utama
		if lockZ then
			hrp.CFrame = CFrame.new(currentPos.X, currentPos.Y, lockZ) * hrp.CFrame.Rotation
		end
		
		-- BATAS BERHENTI SANGAT KETAT & BEKUKAN KARAKTER (FREEZE ANCHOR)
		local stopRadius = isFinalTarget and 0.5 or 0.7
		if dist <= stopRadius then
			-- 1. Paksa posisi tepat ke target (Position Snap)
			hrp.CFrame = CFrame.new(Vector3.new(targetPos.X, currentPos.Y, targetPos.Z)) * hrp.CFrame.Rotation
			
			-- 2. Matikan kecepatan gerak humanoid
			hum:MoveTo(hrp.Position)
			
			-- 3. BEKUKAN KARAKTER (ANCHOR) SELAMA BEBERAPA MILIDETIK UNTUK MENGHENTIKAN MOMENTUM TOTAL
			hrp.Anchored = true
			task.wait(0.15)
			hrp.Anchored = false
			
			break
		end
		
		hum:MoveTo(flatTarget)
		
		if shouldJump or isPlayerCarryingEgg() then
			if os.clock() - lastJumpTime > 0.25 then
				hum.Jump = true
				lastJumpTime = os.clock()
			end
		end

		if os.clock() - startTime > 10 then
			EmergencyBrake()
			break
		end
	end
	return true
end

-- NAVIGASI UTAMA DENGAN RUTE KHUSUS LIGHT & DARK
TravelRoadPath = function(targetPos, shouldJump, areaId)
	local char, hum, hrp = getCharacterAndRoot()
	if not hum or not hrp or not targetPos then return false end
	if avoidTrapsEnabled then pcall(NeutralizeTraps) end
	
	local startPos = hrp.Position
	local safeY = math.max(startPos.Y, targetPos.Y, 70.4)
	
	-- 1. Pindah ke jalur tengah terlebih dahulu jika belum di jalur utama
	if math.abs(startPos.Z - MAIN_ROAD_Z) > 1.0 then
		PreciseWalkTo(Vector3.new(startPos.X, safeY, MAIN_ROAD_Z), shouldJump, false, nil)
		EmergencyBrake()
	end

	local cleanArea = CleanStr(areaId or selectedStealAreas)

	-- 2. Transit Checkpoint khusus berdasarkan Area Kiri, Kanan, atau Light & Dark
	if cleanArea == "lightdark" then
		-- Lewat kanan dulu, lalu singgah ke koordinat khusus, baru ke tengah
		local rightTransit = Vector3.new(543.38, safeY, -321.13)
		PreciseWalkTo(Vector3.new(rightTransit.X, safeY, MAIN_ROAD_Z), shouldJump, false, MAIN_ROAD_Z)
		PreciseWalkTo(rightTransit, shouldJump, false, nil)
		EmergencyBrake()
		
		-- Singgah ke koordinat khusus Light & Dark (dari kanan perlahan menuju ke tengah)
		local customLightDarkPos = Vector3.new(5447.64, safeY, -366.66)
		PreciseWalkTo(customLightDarkPos, shouldJump, false, nil)
		EmergencyBrake()
	elseif RIGHT_AREAS[cleanArea] then
		local rightTransit = Vector3.new(543.38, safeY, -321.13)
		PreciseWalkTo(Vector3.new(rightTransit.X, safeY, MAIN_ROAD_Z), shouldJump, false, MAIN_ROAD_Z)
		PreciseWalkTo(rightTransit, shouldJump, false, nil)
		EmergencyBrake()
	else
		local leftTransit = Vector3.new(543.55, safeY, -407.30)
		PreciseWalkTo(Vector3.new(leftTransit.X, safeY, MAIN_ROAD_Z), shouldJump, false, MAIN_ROAD_Z)
		PreciseWalkTo(leftTransit, shouldJump, false, nil)
		EmergencyBrake()
	end

	-- 3. Berjalan lurus menyusuri sumbu X menuju sejajar titik target
	PreciseWalkTo(Vector3.new(targetPos.X, safeY, targetPos.Z), shouldJump, false, nil)
	EmergencyBrake()

	-- 4. Belok siku menuju titik telur dengan pengereman ketat & freeze anchor
	PreciseWalkTo(Vector3.new(targetPos.X, targetPos.Y, targetPos.Z), shouldJump, true, nil)
	EmergencyBrake()

	return true
end

local function GetEggRarityInfo(egg)
	if not egg then return "Common", 100 end
	local rawRarity = "Common"

	if egg.Rarity then
		local r = egg.Rarity
		rawRarity = type(r) == "table" and (r.DisplayName or r._id or r.Name) or tostring(r)
	elseif egg.AssetCategory or egg.Category or egg.Name then
		local cat = egg.AssetCategory or egg.Category or egg.Name
		if cat and AssetsData then
			local assetsDir = AssetsData.Directory or AssetsData
			local aInfo = assetsDir[cat]
			if aInfo and aInfo.Rarity then
				local r = aInfo.Rarity
				rawRarity = type(r) == "table" and (r.DisplayName or r._id or r.Name) or tostring(r)
			end
		end
	end

	local cleanName = CleanStr(rawRarity)
	local score = RARITY_SCORE_MAP[cleanName] or 100
	return rawRarity, score
end

local function isRarityAllowed(rarityName)
	if selectedStealRarities == "All" or selectedStealRarities == "" then return true end
	return CleanStr(rarityName) == CleanStr(selectedStealRarities)
end

local function isAreaAllowed(areaId)
	if selectedStealAreas == "All" or selectedStealAreas == "" then return true end
	return CleanStr(areaId) == CleanStr(selectedStealAreas)
end

local function GetMatchingFieldEggs()
	if not EggState or not EggState.ReadFieldEggs then return {} end
	local ok, snapshot = pcall(EggState.ReadFieldEggs)
	if not ok or not snapshot or not snapshot.Records then return {} end
	
	local matched = {}
	for _, record in ipairs(snapshot.Records) do
		if record.State == "Slot" and record.BoundsCFrame then
			local isIgnored = ignoredEggs[record.Uid] and (os.clock() - ignoredEggs[record.Uid] < 2.5)
			if not isIgnored then
				local areaOk = isAreaAllowed(record.AreaId)
				local rarityName, baseScore = GetEggRarityInfo(record)
				local rarityOk = isRarityAllowed(rarityName)

				if areaOk and rarityOk then
					table.insert(matched, {
						record = record,
						rarity = rarityName,
						score = baseScore
					})
				end
			end
		end
	end

	if #matched > 1 then
		table.sort(matched, function(a, b) return a.score > b.score end)
	end

	return matched
end

local function StealSpecificEggRobust(targetItem)
	local record = targetItem.record or targetItem
	if not record or not record.Uid or not record.BoundsCFrame then return false end
	local _, _, hrp = getCharacterAndRoot()
	if not hrp then return false end

	if isPlayerCarryingEgg() then 
		UnequipHeldTools()
		if isPlayerCarryingEgg() then return true end
	end

	local targetPos = record.BoundsCFrame.Position
	TravelRoadPath(targetPos, false, record.AreaId)
	
	EmergencyBrake()
	task.wait(0.05)

	local slotKey = nil
	if AreaEggSlotIdentity and AreaEggSlotIdentity.LooksLikeFirstAreaUid and AreaEggSlotIdentity.LooksLikeFirstAreaUid(record.Uid) then
		slotKey = AreaEggSlotIdentity.SlotKey(record.AreaId, record.NestId)
	end

	local net = ReplicatedStorage:FindFirstChild("Packages") and ReplicatedStorage.Packages:FindFirstChild("Networking")
	local carryRemote = net and net:FindFirstChild("RF/EggWorld/AskFieldEggCarry")
	if carryRemote then pcall(function() carryRemote:InvokeServer({ Uid = record.Uid, FirstAreaSlotKey = slotKey }) end) end
	pcall(function()
		if EggState and EggState.CarryFieldEgg then EggState.CarryFieldEgg(record.Uid, slotKey) end
	end)

	local prompt = nil
	for _, d in ipairs(Workspace:GetDescendants()) do
		if d:IsA("ProximityPrompt") and d.Name == "CarryAreaEgg" and d.Enabled then
			local p = d.Parent
			if p:IsA("Attachment") then p = p.Parent end
			if p and (p.Position - hrp.Position).Magnitude < 14 then prompt = d; break end
		end
	end
	
	if prompt then
		pcall(function()
			prompt:InputHoldBegin()
			task.wait(0.02)
			prompt:InputHoldEnd()
		end)
	end

	local tPickup = os.clock()
	local carried = false
	
	while os.clock() - tPickup < 1.0 do
		if isPlayerCarryingEgg() then 
			carried = true 
			break 
		end
		task.wait(0.01)
	end

	ExecuteSafeZoneTeleport()

	TravelRoadPath(POST_STEAL_TARGET_POS, true, "SafeZone")
	EmergencyBrake()

	UnequipHeldTools()
	task.wait(0.1)

	return true
end

StartAutoStealLoop = function()
	task.spawn(function()
		while isAutoStealActive do
			local eggs = GetMatchingFieldEggs()
			if #eggs > 0 then
				StealSpecificEggRobust(eggs[1])
			else
				task.wait(0.3)
			end
			task.wait(0.1)
		end
	end)
end

