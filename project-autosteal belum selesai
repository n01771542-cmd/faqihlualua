local function UpdateSlider(input)
	local barAbsPos = SliderBar.AbsolutePosition.X
	local barAbsSize = SliderBar.AbsoluteSize.X
	local mouseX = input.Position.X
	local alpha = math.clamp((mouseX - barAbsPos) / barAbsSize, 0, 1)
	local currentSpeed = math.floor(MIN_WALK_SPEED + (alpha * (MAX_WALK_SPEED - MIN_WALK_SPEED)))

	walkSpeed = currentSpeed

	SliderValue.Text = tostring(currentSpeed)
	SliderFill.Size = UDim2.fromScale(alpha, 1)
	SliderKnob.Position = UDim2.new(alpha, -6, 0.5, -6)
end

