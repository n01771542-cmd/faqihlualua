local AC_State = nil

local function FetchAnticheatState()
	if AC_State then return AC_State end
	if not getgc then return nil end

	for _, obj in ipairs(getgc(true)) do
		if type(obj) == "table" and rawget(obj, "SampleHistory") and rawget(obj, "Evidence") then
			AC_State = obj
			return AC_State
		end
	end
	return nil
end

local function AdoptTeleportBaseline(targetCFrame)
	local ac = FetchAnticheatState()
	if not ac then return end

	pcall(function()
		if ac.SampleHistory and type(ac.SampleHistory) == "table" then
			table.clear(ac.SampleHistory)
		end
		if ac.Evidence and type(ac.Evidence) == "table" then
			if ac.Evidence.Speed then ac.Evidence.Speed = 0 end
			if ac.Evidence.Flight then ac.Evidence.Flight = 0 end
			if ac.Evidence.Teleport then ac.Evidence.Teleport = 0 end
		end
		if ac.Mode then
			ac.Mode = "Grounded"
		end
		if ac.BaselineSample and type(ac.BaselineSample) == "table" then
			ac.BaselineSample.CFrame = targetCFrame
			ac.BaselineSample.Position = targetCFrame.Position
			ac.BaselineSample.Time = os.clock()
		end
	end)
end

