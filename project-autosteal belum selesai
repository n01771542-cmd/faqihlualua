			sText.Text = "ON"
			sText.TextColor3 = Theme.OnAccent
			dot.BackgroundColor3 = Theme.OnAccent
			Tween(btn, 0.2, { BackgroundColor3 = Theme.On })
			Tween(stroke, 0.2, { Color = Theme.OnStroke })
		else
			sText.Text = "OFF"
			sText.TextColor3 = Theme.TextMuted
			dot.BackgroundColor3 = Color3.fromRGB(100, 111, 130)
			Tween(btn, 0.2, { BackgroundColor3 = Theme.Off })
			Tween(stroke, 0.2, { Color = Theme.OffStroke })
		end
		callback(active)
	end)

	return btn
end

