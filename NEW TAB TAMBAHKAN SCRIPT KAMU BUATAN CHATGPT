local function GetScriptID(entry)
    if type(entry) ~= "table" then
        return ""
    end

    return tostring(entry.name or "")
        .. "|"
        .. tostring(entry.url or "")
end

local function GetAllScripts()
    local result = {}

    for _, entry in ipairs(CleanedScripts) do
        table.insert(result, entry)
    end

    for _, entry in ipairs(CustomScriptsData) do
        table.insert(result, entry)
    end

    return result
end

local FavoriteScriptsData = {}

local function RefreshFavoritesData()
    FavoriteScriptsData = {}

    for _, entry in ipairs(GetAllScripts()) do
        local id = GetScriptID(entry)

        if id ~= "" and FavoriteList[id] then
            table.insert(FavoriteScriptsData, entry)
        end
    end
end

