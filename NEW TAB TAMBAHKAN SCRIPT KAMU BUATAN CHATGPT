local function RunScript(scriptEntry)
    if type(scriptEntry) ~= "table" then
        return false, "invalid script"
    end

    if type(scriptEntry.run) == "function" then
        local success, result = pcall(scriptEntry.run, scriptEntry)

        if success then
            return true, result
        end

        return false, tostring(result)
    end

    return false, "run handler unavailable"
end

